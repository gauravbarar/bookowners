{
  "name": "@books/api-client",
  "version": "1.0.0",
  "description": "TypeScript types for the book owners API, generated from its OpenAPI document",
  "private": true,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.d.ts",
    "generated.d.ts",
    "openapi.json"
  ],
  "scripts": {
    "generate": "dotnet build ../../src/BookOwners.Api -p:OpenApiGenerateDocumentsOnBuild=true && openapi-typescript openapi.json -o generated.d.ts",
    "package": "npm run generate && npm pack"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
