# Copy to .env and set a strong password (8+ characters, mixed case, digits and symbols).
# Avoid ";" because the password is placed inside a connection string.
MSSQL_SA_PASSWORD=

# The browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# Set to true to read book owners from the Bupa API instead of MSSQL.
USE_BUPA_API=false
